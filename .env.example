# Copy to backend/.env and fill in. All settings use the CL_ prefix.
CL_ENV=dev
CL_DATABASE_URL=sqlite:///./controllens.db
# CL_DATABASE_URL=postgresql+psycopg://controllens:controllens@localhost:5432/controllens
CL_STORAGE_DIR=./storage
CL_JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
CL_CORS_ORIGINS=http://localhost:5173

# AI: leave the key empty to run in offline demo mode
CL_ANTHROPIC_API_KEY=
CL_LLM_MODEL=claude-sonnet-5-5
CL_LLM_PROVIDER=auto

# First start only
CL_SEED_ADMIN_EMAIL=admin@controllens.local
CL_SEED_ADMIN_PASSWORD=Admin#12345
CL_SEED_DEMO=true
CL_SEED_DEMO_PASSWORD=Demo#12345
